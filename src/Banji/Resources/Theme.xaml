<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         鸿蒙字体：HarmonyOS Sans SC（资源内嵌）
         用法约定：直接使用 Font.Thin / Font.Light / Font.Regular /
                   Font.Medium / Font.Bold / Font.Black 作为 FontFamily，
                   不需要再额外设置 FontWeight（Bold 资源请配合 FontWeight=Bold）。
         ============================================================ -->
    <FontFamily x:Key="Font.Thin">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC Thin</FontFamily>
    <FontFamily x:Key="Font.Light">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC Light</FontFamily>
    <FontFamily x:Key="Font.Regular">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="Font.Medium">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC Medium</FontFamily>
    <FontFamily x:Key="Font.Bold">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="Font.Black">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC Black</FontFamily>

    <!-- 便捷别名 -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC</FontFamily>

    <!-- ============================================================
         颜色（默认值，均可在设置中自定义）
         ============================================================ -->
    <Color x:Key="Color.Brand">#317FFF</Color>
    <Color x:Key="Color.BrandHover">#5998FF</Color>
    <Color x:Key="Color.BrandPressed">#0051D6</Color>
    <Color x:Key="Color.Accent">#FF3030</Color>
    <Color x:Key="Color.BubbleBorder">#3E6BFF</Color>
    <Color x:Key="Color.BubbleText">#2E69FF</Color>
    <Color x:Key="Color.TextPrimary">#1F2329</Color>
    <Color x:Key="Color.TextSecondary">#6B7280</Color>
    <Color x:Key="Color.TextTertiary">#9AA3AF</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F5F7FB</Color>
    <Color x:Key="Color.Divider">#E5E9F2</Color>
    <Color x:Key="Color.Warning">#FF9F1C</Color>
    <Color x:Key="Color.Success">#22C55E</Color>

    <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="Brush.BrandHover" Color="{StaticResource Color.BrandHover}" />
    <SolidColorBrush x:Key="Brush.BrandPressed" Color="{StaticResource Color.BrandPressed}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.BubbleBorder" Color="{StaticResource Color.BubbleBorder}" />
    <SolidColorBrush x:Key="Brush.BubbleText" Color="{StaticResource Color.BubbleText}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />

    <!-- ============================================================
         字号 / 圆角 / 间距
         ============================================================ -->
    <sys:Double x:Key="FontSize.Xs">11</sys:Double>
    <sys:Double x:Key="FontSize.Sm">12</sys:Double>
    <sys:Double x:Key="FontSize.Md">14</sys:Double>
    <sys:Double x:Key="FontSize.Lg">18</sys:Double>
    <sys:Double x:Key="FontSize.Xl">24</sys:Double>
    <sys:Double x:Key="FontSize.Huge">34</sys:Double>
    <CornerRadius x:Key="Radius.Win11">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ============================================================
         基础文字样式（WPF 默认样式，可在任意窗口覆盖）
         ============================================================ -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Thin" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Thin}" />
    </Style>
    <Style x:Key="Text.Light" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Light}" />
    </Style>
    <Style x:Key="Text.Medium" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
    </Style>
    <Style x:Key="Text.Bold" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Text.Black" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Black}" />
    </Style>
    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Bold}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Xl}" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Medium}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Lg}" />
    </Style>

    <!-- 默认深色文字（普通 TextBlock 兜底） -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

    <!-- ============================================================
         基础输入控件（设置/花名册/课表窗口通用）
         ============================================================ -->
    <Style TargetType="TextBox" x:Key="Input.TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Brand}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 普通按钮（窗口内表单按钮，非宠物功能区） -->
    <Style TargetType="Button" x:Key="Button.Form">
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Brush.Brand}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.BrandHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.BrandPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Button.FormGhost" BasedOn="{StaticResource Button.Form}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
    </Style>

    <!-- 普通滚动条（薄，圆角） -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#C8D2E0" CornerRadius="4" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
