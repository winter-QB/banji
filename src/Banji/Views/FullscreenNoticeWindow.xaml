<Window x:Class="Banji.Views.FullscreenNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班机提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <!-- 上课提示的可选模糊桌面背景 -->
        <Image x:Name="BackdropImage" Stretch="Fill" Visibility="Collapsed" />
        <!-- 上课提示的醒目底色 / 渐变层 -->
        <Border x:Name="ColorLayer" Background="Transparent" />

        <!-- ===================== 上课提示 ===================== -->
        <Grid x:Name="ClassStartPanel" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,40,40,110">
                <TextBlock x:Name="StartTitle"
                           Text="上课"
                           FontFamily="{StaticResource Font.Black}"
                           FontSize="130"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Direction="270" ShadowDepth="8" BlurRadius="36" Opacity="0.35" Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="StartCourse"
                           FontFamily="{StaticResource Font.Bold}"
                           FontSize="76"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Direction="270" ShadowDepth="5" BlurRadius="22" Opacity="0.28" Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="StartPeriod"
                           FontFamily="{StaticResource Font.Medium}"
                           FontSize="30"
                           Foreground="#F2FFFFFF"
                           Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock x:Name="StartHint"
                           Text="点击任意位置关闭（或按 ESC）"
                           FontFamily="{StaticResource Font.Light}"
                           FontSize="18"
                           Foreground="#B3FFFFFF"
                           Margin="0,48,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ===================== 下课提示（纯文字，不遮挡点击） ===================== -->
        <Grid x:Name="ClassEndPanel" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,40,40,110">
                <TextBlock x:Name="EndTitle"
                           Text="下课"
                           FontFamily="{StaticResource Font.Black}"
                           FontSize="110"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock x:Name="EndNext"
                           FontFamily="{StaticResource Font.Medium}"
                           FontSize="34"
                           Margin="0,26,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <TextBlock x:Name="EndHint"
                           Text=""
                           FontFamily="{StaticResource Font.Light}"
                           FontSize="18"
                           Margin="0,40,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ========== 底部共用：自动关闭进度条 + “N 秒后自动关闭”小字 ========== -->
        <Grid x:Name="AutoCloseArea" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="AutoCloseText"
                       Grid.Row="0"
                       Text="4 秒后自动关闭（点击或按 ESC 立即关闭）"
                       FontFamily="{StaticResource Font.Light}"
                       FontSize="17"
                       Foreground="#D9FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="2" BlurRadius="12" Opacity="0.55" Color="#000000" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 细进度条（约 1~2px，随停留时间收缩到 0） -->
            <Grid Grid.Row="1" x:Name="ProgressTrack" Background="#33FFFFFF">
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#E6FFFFFF" />
            </Grid>
        </Grid>
    </Grid>
</Window>
