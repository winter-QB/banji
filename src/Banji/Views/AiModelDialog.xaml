<Window x:Class="Banji.Views.AiModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模型管理 - 班机"
        Width="900" Height="760" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#1F2329" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DangerGhost" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
            <Setter Property="Foreground" Value="#D63A3A" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource Button.Form}">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="MiniGhostButton" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="RecommendedBadge" TargetType="Border">
            <Setter Property="Background" Value="#FFF1D6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="10,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 标题 ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="AI 模型管理" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="24" Foreground="#1F2329" />
            <TextBlock Text="端侧生成式 AI：模型不随安装包分发，下载到本机后完全离线运行；下载源为国内 hf-mirror 镜像。"
                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ============ 当前模型 ============ -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,13" Margin="0,14,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1F2329" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前模型" FontSize="12" Foreground="#8A93A3" VerticalAlignment="Center" />
                        <Border x:Name="CurrentStatusBadge" Background="#EEF2F8" CornerRadius="6"
                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStatusText" Text="未安装" FontSize="11"
                                       Foreground="#6B7280" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="CurrentNameText" Style="{StaticResource CardTitle}" Margin="0,5,0,0"
                               Text="未选择模型" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentPathText" FontSize="11" Foreground="#9AA3AF" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoadCurrentButton" Content="加载" Style="{StaticResource MiniButton}"
                            Click="OnLoadCurrentClick" />
                    <Button x:Name="UnloadButton" Content="卸载" Style="{StaticResource MiniGhostButton}"
                            Click="OnUnloadClick" />
                    <Button x:Name="DeleteCurrentButton" Content="删除" Style="{StaticResource DangerGhost}"
                            Click="OnDeleteCurrentClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 可下载模型列表 ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <ItemsControl x:Name="ModelList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="16,13" Margin="0,0,0,10"
                                BorderBrush="#E5E9F2" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                        <Border Style="{StaticResource RecommendedBadge}"
                                                Visibility="{Binding RecommendedVisibility}">
                                            <TextBlock Text="推荐" FontSize="10" Foreground="#B7791F" />
                                        </Border>
                                        <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="#22A55E"
                                                   Margin="12,2,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#317FFF"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="#8A93A3" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,9,0,0" Visibility="{Binding ProgressVisibility}">
                                        <ProgressBar Height="7" Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Foreground="{StaticResource Brush.Brand}"
                                                     Background="#EAF1FF" BorderThickness="0" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                   Foreground="#6B7280" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding DownloadButtonText}" Style="{StaticResource MiniButton}"
                                            Visibility="{Binding DownloadButtonVisibility}"
                                            Click="OnDownloadClick" />
                                    <Button Content="取消" Style="{StaticResource DangerGhost}"
                                            Visibility="{Binding CancelButtonVisibility}"
                                            Click="OnCancelDownloadClick" />
                                    <Button Content="{Binding LoadButtonText}" Style="{StaticResource MiniGhostButton}"
                                            Visibility="{Binding LoadButtonVisibility}"
                                            IsEnabled="{Binding LoadButtonEnabled}"
                                            Click="OnLoadCardClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============ 底部工具条 ============ -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="选择本地 GGUF 文件…"
                        Style="{StaticResource Button.Form}" Padding="16,8" FontSize="12"
                        Click="OnChooseLocalClick" />
                <Button Grid.Column="1" Content="打开模型文件夹" Style="{StaticResource MiniGhostButton}"
                        Margin="10,0,0,0" Click="OnOpenFolderClick" />
                <Button Grid.Column="2" Content="刷新" Style="{StaticResource MiniGhostButton}"
                        Margin="10,0,0,0" Click="OnRefreshClick" />

                <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="模型目录" FontSize="10" Foreground="#9AA3AF" />
                    <TextBlock x:Name="ModelDirText" FontSize="11" Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="FooterStatusText" Grid.Column="4" Text="" FontSize="11"
                           Foreground="#8A93A3" VerticalAlignment="Center" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
