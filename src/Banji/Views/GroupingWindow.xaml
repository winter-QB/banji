<Window x:Class="Banji.Views.GroupingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随机分组 - 班机"
        Width="940" Height="740" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="随机分组" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="24" Foreground="#1F2329" />
            <TextBlock Text="把花名册里的学生随机分成若干小组；可开启“按成绩均衡”让各组平均分尽量接近。"
                       FontSize="12" Foreground="#8A93A3" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 选项 -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,14,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="花名册" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="RosterCombo" FontSize="13" SelectionChanged="OnRosterChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="分成几组" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="GroupCountCombo" FontSize="13" SelectionChanged="OnOptionsChanged" />
                </StackPanel>

                <CheckBox x:Name="BalanceCheck" Grid.Column="4" Content="按成绩均衡分组"
                          FontSize="13" Foreground="#3A4252" VerticalAlignment="Bottom"
                          Margin="0,0,18,8" IsChecked="True" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged"
                          ToolTip="开启后按成绩蛇形分配，各组平均分更接近" />

                <Button x:Name="GenerateButton" Grid.Column="5" Content="生成分组"
                        Style="{StaticResource Button.Form}" Padding="22,8" VerticalAlignment="Bottom"
                        Click="OnGenerateClick" />
            </Grid>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,2,0,0">
                    <ItemsControl x:Name="ResultList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="408" Background="#F8FAFF" BorderBrush="#E3E9F5" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="4" Height="16" CornerRadius="2"
                                                        Background="#317FFF" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Bold}"
                                                           FontWeight="Bold" FontSize="16" Foreground="#1F2329"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" HorizontalAlignment="Right"
                                                       FontSize="12" Foreground="#8A93A3" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Members}" FontSize="13" Foreground="#3A4252"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 未生成时的空状态 -->
                <StackPanel x:Name="EmptyResultPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#F1F5FF" HorizontalAlignment="Center">
                        <TextBlock Text="组" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="30"
                                   Foreground="#317FFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有分组结果" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                               FontSize="20" Foreground="#B8C0CE" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="选好花名册和组数后点“生成分组”，结果会显示在这里。"
                               FontSize="12" Foreground="#9AA3AF" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="" FontSize="12" Foreground="#8A93A3"
                   Margin="4,10,0,0" TextWrapping="Wrap" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RegenerateButton" Content="重新分组" Style="{StaticResource Button.FormGhost}"
                    Padding="16,8" IsEnabled="False" Click="OnGenerateClick" />
            <Button x:Name="CopyButton" Content="复制文本" Style="{StaticResource Button.FormGhost}"
                    Padding="16,8" Margin="8,0,0,0" IsEnabled="False" Click="OnCopyClick" />
            <Button x:Name="ExportButton" Content="导出 CSV" Style="{StaticResource Button.FormGhost}"
                    Padding="16,8" Margin="8,0,0,0" IsEnabled="False" Click="OnExportClick" />
            <Button Content="关闭" Style="{StaticResource Button.Form}" Padding="22,8" Margin="12,0,0,0"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
