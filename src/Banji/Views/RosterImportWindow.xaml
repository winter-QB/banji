<Window x:Class="Banji.Views.RosterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入花名册 - 班机"
        Width="940" Height="760" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EFF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFE" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FD" />
            <Setter Property="Foreground" Value="#5A6474" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="导入花名册" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="22" Foreground="#1F2329" />
            <TextBlock Text="支持 .xlsx / .xlsm / .csv / .tsv / .txt，自动识别表头与姓名、学号、成绩列。旧版 .xls 请先另存为 .xlsx。"
                       FontSize="12" Foreground="#8A93A3" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 文件选择 -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathBox" Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     IsReadOnly="True" Foreground="#4B5563" />
            <Button Grid.Column="1" Content="选择文件…" Style="{StaticResource Button.Form}"
                    Padding="14,7" Margin="10,0,0,0" Click="OnBrowseClick" />
            <Button x:Name="ClearButton" Grid.Column="2" Content="清空" Style="{StaticResource Button.FormGhost}"
                    Padding="14,7" Margin="8,0,0,0" Click="OnClearClick" />
        </Grid>

        <!-- 解析设置 -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="工作表" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <ComboBox x:Name="SheetCombo" FontSize="13" SelectionChanged="OnSheetChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="表头行" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <ComboBox x:Name="HeaderCombo" FontSize="13" SelectionChanged="OnHeaderChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="花名册名称" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <TextBox x:Name="NameBox" Style="{StaticResource Input.TextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="学号列" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <ComboBox x:Name="IdColumnCombo" FontSize="13" SelectionChanged="OnColumnMappingChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="姓名列" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <ComboBox x:Name="NameColumnCombo" FontSize="13" SelectionChanged="OnColumnMappingChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="成绩列（可选）" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                        <ComboBox x:Name="ScoreColumnCombo" FontSize="13" SelectionChanged="OnColumnMappingChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HintText" Text="选择一个文件后，这里会显示自动识别的结果。"
                           FontSize="12" Foreground="#6B7280" Margin="2,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 样例数据 -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="样例数据（★ 为当前映射列，最多显示 12 行）"
                           FontSize="12" Foreground="#6B7280" Margin="6,2,0,6" />
                <DataGrid x:Name="SampleGrid" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="4" Text="" FontSize="12" Foreground="#D93025"
                   Margin="4,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource Button.FormGhost}" Padding="20,8" Click="OnCancelClick" />
            <Button x:Name="ImportButton" Content="开始导入" Style="{StaticResource Button.Form}"
                    Padding="20,8" Margin="10,0,0,0" Click="OnImportClick" />
        </StackPanel>
    </Grid>
</Window>
