<Window x:Class="Banji.Views.RosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="花名册管理 - 班机"
        Width="1020" Height="700" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 左侧花名册列表项 -->
        <Style x:Key="RosterListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF3FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3ECFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 学生表格 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EFF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFE" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FD" />
            <Setter Property="Foreground" Value="#5A6474" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3ECFF" />
                    <Setter Property="Foreground" Value="#1F2329" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Grid Grid.Row="0" Margin="24,18,24,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="花名册管理"
                           FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="24"
                           Foreground="#1F2329" />
                <TextBlock Text="管理课堂抽签用的学生名单（数量无上限）"
                           Margin="14,0,0,4" VerticalAlignment="Bottom" FontSize="12" Foreground="#8A93A3" />
            </StackPanel>
            <Button x:Name="HeaderImportButton" Content="导入文件"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource Button.Form}" Padding="14,7" Click="OnImportRosterClick" />
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="24,0,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：花名册列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,0,10">
                        <TextBlock Text="花名册列表" Style="{StaticResource Text.Medium}" FontSize="14" />
                        <Border Background="#EAF1FF" CornerRadius="999" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RosterCountText" Text="0 份" FontSize="11" Foreground="#317FFF" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="NewManualButton" Content="＋ 手动新建" Style="{StaticResource Button.Form}"
                                FontSize="12" Padding="10,6" Click="OnNewManualClick" />
                        <Button x:Name="ImportButton" Content="导入" Style="{StaticResource Button.FormGhost}"
                                FontSize="12" Padding="10,6" Margin="8,0,0,0" Click="OnImportRosterClick" />
                        <Button x:Name="DeleteRosterButton" Content="删除" Style="{StaticResource Button.FormGhost}"
                                FontSize="12" Padding="10,6" Margin="8,0,0,0" Click="OnDeleteRosterClick" />
                    </StackPanel>

                    <ListBox x:Name="RosterList" Grid.Row="2" ItemContainerStyle="{StaticResource RosterListItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnRosterSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Medium}"
                                                       FontSize="14" Foreground="#1F2329" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#E6F7EE" CornerRadius="999" Padding="6,0" Margin="6,1,0,0"
                                                    Visibility="{Binding ActiveVisibility}">
                                                <TextBlock Text="当前" FontSize="10" Foreground="#12A150" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8A93A3"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                                               Foreground="#9AA3AF" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：详情区 -->
            <Grid x:Name="DetailArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 + 操作 -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DetailNameText" Text="—"
                                       FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="20"
                                       Foreground="#1F2329" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailMetaText" Text="" FontSize="12" Foreground="#8A93A3" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SetActiveButton" Content="设为当前" Style="{StaticResource Button.Form}"
                                    FontSize="12" Padding="12,6" Click="OnSetActiveClick" />
                            <Button x:Name="EditButton" Content="编辑信息" Style="{StaticResource Button.FormGhost}"
                                    FontSize="12" Padding="12,6" Margin="8,0,0,0" Click="OnToggleEditClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 可折叠的信息编辑面板 -->
                <Border x:Name="EditPanel" Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="编辑花名册信息" Style="{StaticResource Text.Medium}" FontSize="13" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="花名册名称" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                                <TextBox x:Name="DetailNameBox" Style="{StaticResource Input.TextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="学科（可选）" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                                <TextBox x:Name="DetailSubjectBox" Style="{StaticResource Input.TextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Button Content="保存" Style="{StaticResource Button.Form}" FontSize="12" Padding="14,7" Click="OnSaveEditClick" />
                                <Button Content="取消" Style="{StaticResource Button.FormGhost}" FontSize="12" Padding="14,7" Margin="8,0,0,0" Click="OnCancelEditClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 工具行：排序 / 显示模式 / 成绩列 -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12,8" Margin="0,10,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="排序" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                            <ComboBox x:Name="SortCombo" Width="128" Margin="6,0,16,0" FontSize="12"
                                      SelectionChanged="OnSortChanged">
                                <ComboBoxItem Tag="Original" Content="原始顺序" />
                                <ComboBoxItem Tag="Score" Content="按成绩" />
                                <ComboBoxItem Tag="Name" Content="按姓名" />
                                <ComboBoxItem Tag="StudentId" Content="按学号" />
                            </ComboBox>
                            <TextBlock Text="抽签显示" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                            <ComboBox x:Name="DisplayCombo" Width="126" Margin="6,0,16,0" FontSize="12"
                                      SelectionChanged="OnDisplayModeChanged">
                                <ComboBoxItem Content="跟随全局" />
                                <ComboBoxItem Content="只显示学号" />
                                <ComboBoxItem Content="只显示姓名" />
                                <ComboBoxItem Content="学号 + 姓名" />
                            </ComboBox>
                            <CheckBox x:Name="ShowScoreCheck" Content="显示成绩列" IsChecked="True" FontSize="12"
                                      VerticalAlignment="Center" Checked="OnShowScoreChanged" Unchecked="OnShowScoreChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="StudentCountText" Text="共 0 人" FontSize="12" Foreground="#8A93A3"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button x:Name="SaveStudentsButton" Content="保存修改" Style="{StaticResource Button.FormGhost}"
                                    FontSize="12" Padding="12,6" Click="OnSaveStudentsClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 学生表格 -->
                <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="6">
                    <DataGrid x:Name="StudentGrid" IsReadOnly="False" SelectionUnit="CellOrRowHeader"
                              CanUserSortColumns="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="学号" Width="180"
                                                Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="姓名" Width="200"
                                                Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="成绩" Width="120"
                                                Binding="{Binding Score, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="4" Text="" FontSize="12" Foreground="#8A93A3"
                           Margin="4,8,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 空状态引导 -->
            <Border x:Name="EmptyPanel" Grid.Column="2" Background="White" CornerRadius="12" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#F1F5FF" HorizontalAlignment="Center">
                        <TextBlock Text="名" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="30"
                                   Foreground="#317FFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有花名册" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="22"
                               Foreground="#1F2329" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="导入一份 Excel / CSV 名单，或者一个个手动录入。&#10;花名册数量没有上限，不同科目可以用不同名单。"
                               FontSize="13" Foreground="#8A93A3" HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,10,0,0" LineHeight="22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="导入文件" Style="{StaticResource Button.Form}" Click="OnImportRosterClick" />
                        <Button Content="手动录入" Style="{StaticResource Button.FormGhost}" Margin="10,0,0,0"
                                Click="OnNewManualClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <Grid Grid.Row="2" Margin="24,0,24,14">
            <TextBlock Text="提示：双击“学号 / 姓名 / 成绩”单元格即可直接修改，改完点“保存修改”落盘。"
                       FontSize="11" Foreground="#9AA3AF" />
        </Grid>
    </Grid>
</Window>
