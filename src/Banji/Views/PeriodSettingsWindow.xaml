<Window x:Class="Banji.Views.PeriodSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课堂时段设置 — 班机"
        Width="920" Height="700"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="{StaticResource Font.Regular}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="课堂时段设置" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="24" Foreground="#1F2329" />
            <TextBlock Text="自定义每节课的起止时间（精确到秒）；抽签的课堂窗口、上下课提示都按这里的时间执行。"
                       FontSize="13" Foreground="#6B7280" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 提示 -->
        <Border Grid.Row="1" Background="#EAF2FF" CornerRadius="8" Padding="12,8" Margin="0,14,0,14">
            <TextBlock FontSize="12" Foreground="#317FFF" TextWrapping="Wrap"
                       Text="时间格式支持 HH:mm 或 HH:mm:ss（例如 08:00、08:00:30）。结束时间必须晚于开始时间，且各节之间不能重叠；午休/课间也要满足结束晚于开始。" />
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 课堂时段 -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E5E9F2"
                    BorderThickness="1" Padding="14" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="新增一节" Style="{StaticResource Button.FormGhost}" Padding="12,6"
                                    FontSize="13" Click="OnAddPeriodClick" />
                            <Button Content="删除选中" Style="{StaticResource Button.FormGhost}" Padding="12,6"
                                    FontSize="13" Margin="8,0,0,0" Click="OnDeletePeriodClick" />
                        </StackPanel>
                        <TextBlock Text="课堂时段" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                                   FontSize="17" Foreground="#1F2329" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid x:Name="PeriodGrid" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="White" BorderThickness="0" RowHeight="38"
                              FontFamily="{StaticResource Font.Regular}" FontSize="13"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="节次名称" Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="开始时间" Width="120"
                                                Binding="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="结束时间" Width="120"
                                                Binding="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="PeriodHint" FontSize="12" Foreground="#9AA3AF" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- 午休 / 课间 -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E9F2"
                    BorderThickness="1" Padding="14" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="新增" Style="{StaticResource Button.FormGhost}" Padding="12,6"
                                    FontSize="13" Click="OnAddBreakClick" />
                            <Button Content="删除" Style="{StaticResource Button.FormGhost}" Padding="12,6"
                                    FontSize="13" Margin="8,0,0,0" Click="OnDeleteBreakClick" />
                        </StackPanel>
                        <TextBlock Text="午休 / 课间" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                                   FontSize="17" Foreground="#1F2329" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid x:Name="BreakGrid" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="White" BorderThickness="0" RowHeight="38"
                              FontFamily="{StaticResource Font.Regular}" FontSize="13"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="开始" Width="90"
                                                Binding="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="结束" Width="90"
                                                Binding="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="BreakHint" FontSize="12" Foreground="#9AA3AF" Margin="0,8,0,0"
                               TextWrapping="Wrap" Text="午休/大课间不计入课堂时间；名称含“午”的时间段在宠物上显示为午休。" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="从当前课表自动推算" Style="{StaticResource Button.FormGhost}" Padding="14,8"
                        FontFamily="{StaticResource Font.Medium}" Click="OnAutoInferClick"
                        ToolTip="按当前课表的节次时长与课间间隔，重新生成整齐的起止时间" />
                <Button Content="放弃修改" Style="{StaticResource Button.FormGhost}" Padding="14,8"
                        FontFamily="{StaticResource Font.Medium}" Margin="8,0,0,0" Click="OnReloadClick" />
                <Button Content="保存" Style="{StaticResource Button.Form}" Padding="22,8"
                        FontFamily="{StaticResource Font.Medium}" Margin="8,0,0,0" Click="OnSaveClick" />
                <Button Content="关闭" Style="{StaticResource Button.FormGhost}" Padding="14,8"
                        FontFamily="{StaticResource Font.Medium}" Margin="8,0,0,0" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
