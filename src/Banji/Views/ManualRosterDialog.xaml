<Window x:Class="Banji.Views.ManualRosterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动录入花名册 - 班机"
        Width="760" Height="680" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EFF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFE" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FD" />
            <Setter Property="Foreground" Value="#5A6474" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3ECFF" />
                    <Setter Property="Foreground" Value="#1F2329" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="手动录入花名册" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="22" Foreground="#1F2329" />
            <TextBlock Text="一行一位学生，姓名与学号至少填写一个；也可以在下方整批粘贴姓名。"
                       FontSize="12" Foreground="#8A93A3" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 基本信息 -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,14,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="花名册名称" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                    <TextBox x:Name="NameBox" Style="{StaticResource Input.TextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="学科（可选）" FontSize="11" Foreground="#8A93A3" Margin="2,0,0,4" />
                    <TextBox x:Name="SubjectBox" Style="{StaticResource Input.TextBox}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 学生表格 -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,8">
                    <Button Content="＋ 添加一行" Style="{StaticResource Button.Form}" FontSize="12"
                            Padding="10,6" Click="OnAddRowClick" />
                    <Button Content="删除选中行" Style="{StaticResource Button.FormGhost}" FontSize="12"
                            Padding="10,6" Margin="8,0,0,0" Click="OnRemoveRowClick" />
                    <Button Content="清空" Style="{StaticResource Button.FormGhost}" FontSize="12"
                            Padding="10,6" Margin="8,0,0,0" Click="OnClearRowsClick" />
                    <TextBlock x:Name="RowCountText" Text="0 行" FontSize="12" Foreground="#8A93A3"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <DataGrid x:Name="StudentGrid" Grid.Row="1" SelectionUnit="CellOrRowHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="学号" Width="200"
                                            Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="姓名" Width="*"
                                            Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="成绩" Width="120"
                                            Binding="{Binding Score, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 批量粘贴 -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="批量粘贴（一行一个姓名；也支持“学号 姓名 成绩”或“学号,姓名,成绩”）"
                               FontSize="12" Foreground="#6B7280" Margin="0,0,0,6" />
                    <TextBox x:Name="PasteBox" Style="{StaticResource Input.TextBox}" Height="84"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </StackPanel>
                <Button Grid.Column="1" Content="解析并添加" Style="{StaticResource Button.FormGhost}"
                        FontSize="12" Padding="12,8" Margin="12,20,0,0" VerticalAlignment="Top"
                        Click="OnParsePasteClick" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="" FontSize="12" Foreground="#8A93A3" Margin="4,8,0,0" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource Button.FormGhost}" Padding="20,8"
                    Click="OnCancelClick" />
            <Button Content="保存花名册" Style="{StaticResource Button.Form}" Padding="20,8" Margin="10,0,0,0"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
