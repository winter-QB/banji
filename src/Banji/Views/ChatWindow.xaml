<Window x:Class="Banji.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和班机聊聊 - 班机"
        Width="780" Height="720" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 聊天气泡 -->
        <DataTemplate x:Key="ChatBubbleTemplate">
            <Grid Margin="0,3">
                <Border x:Name="Bubble"
                        MaxWidth="540"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#E5E9F2"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="13,9">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#1F2329" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="ContentText"
                                   Text="{Binding DisplayText}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"
                                   Foreground="#232A35" />
                        <TextBlock x:Name="MetaText"
                                   Text="{Binding TimeText}"
                                   FontSize="10"
                                   Foreground="#A6AEBB"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Brush.Brand}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Brush.Brand}" />
                    <Setter TargetName="ContentText" Property="Foreground" Value="White" />
                    <Setter TargetName="MetaText" Property="Foreground" Value="#D6E2FF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 快捷开场白按钮 -->
        <Style x:Key="QuickChip" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#3A6BD6" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CFDFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小幽灵按钮 -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：模型状态 ============ -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1F2329" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 班机头像：方形雾蓝小方块 + 两只圆点眼睛 -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#8FB6F2"
                        VerticalAlignment="Center">
                    <Canvas Width="42" Height="42">
                        <Ellipse Width="5" Height="5" Fill="#231F20" Canvas.Left="11" Canvas.Top="19" />
                        <Ellipse Width="5" Height="5" Fill="#231F20" Canvas.Left="26" Canvas.Top="19" />
                    </Canvas>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="班机" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                                   FontSize="16" Foreground="#1F2329" />
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9AA3AF" Margin="8,0,0,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="未安装模型" FontSize="12" Foreground="#6B7280"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ModelInfoText" Text="本地离线运行，聊天记录只保存在内存"
                               FontSize="11" Foreground="#9AA3AF" Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="ManageButton" Content="模型管理"
                        Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                        Click="OnManageModelsClick" />
                <Button Grid.Column="3" x:Name="ClearButton" Content="清空对话"
                        Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                        Click="OnClearClick" />
            </Grid>
        </Border>

        <!-- ============ 未安装 / 加载中 提示条 ============ -->
        <Border Grid.Row="1" x:Name="BannerPanel" Background="#FFF8E8" BorderBrush="#FFD9A0"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerText" Grid.Column="0" Text="还没有安装 AI 模型。" FontSize="12"
                           Foreground="#8A5A00" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="BannerButton" Grid.Column="1" Content="下载模型"
                        Style="{StaticResource Button.Form}" Padding="14,6" FontSize="12"
                        Margin="12,0,0,0" Click="OnBannerButtonClick" />
            </Grid>
        </Border>

        <!-- ============ 消息列表 ============ -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,10,0,0">
            <Grid>
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="2,2,8,2">
                    <ItemsControl x:Name="MessageList" ItemTemplate="{StaticResource ChatBubbleTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,20,0,40">
                    <Border Width="66" Height="66" CornerRadius="18" Background="#8FB6F2"
                            HorizontalAlignment="Center">
                        <Canvas Width="66" Height="66">
                            <Ellipse Width="8" Height="8" Fill="#231F20" Canvas.Left="17" Canvas.Top="30" />
                            <Ellipse Width="8" Height="8" Fill="#231F20" Canvas.Left="41" Canvas.Top="30" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="和班机聊聊吧" FontFamily="{StaticResource Font.Medium}" FontSize="18"
                               Foreground="#1F2329" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="问问课堂、作业、作息，或者只是课间随便说两句。"
                               FontSize="12" Foreground="#8A93A3" HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Enter 发送，Shift+Enter 换行"
                               FontSize="11" Foreground="#A6AEBB" HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 快捷开场白 ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8" x:Name="QuickPanel">
            <Button Style="{StaticResource QuickChip}" Content="今天上课好困，怎么提神？"
                    Tag="今天上课好困，怎么提神？" Click="OnQuickPromptClick" />
            <Button Style="{StaticResource QuickChip}" Content="帮我出个记单词的小办法"
                    Tag="帮我出个记单词的小办法" Click="OnQuickPromptClick" />
            <Button Style="{StaticResource QuickChip}" Content="课间十分钟可以做什么？"
                    Tag="课间十分钟可以做什么？" Click="OnQuickPromptClick" />
        </StackPanel>

        <!-- ============ 输入区 ============ -->
        <Border Grid.Row="4" Background="White" CornerRadius="14" Padding="12,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#1F2329" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="InputBox"
                             Style="{StaticResource Input.TextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="62" MaxHeight="116"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontSize="14"
                             Padding="10,8"
                             PreviewKeyDown="OnInputKeyDown"
                             TextChanged="OnInputTextChanged" />
                    <TextBlock x:Name="InputPlaceholder" Text="和班机说点什么…（Enter 发送，Shift+Enter 换行）"
                               FontSize="13" Foreground="#A6AEBB" Margin="13,10,0,0"
                               VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="SendButton" Content="发送" Style="{StaticResource Button.Form}"
                            Padding="22,9" Click="OnSendClick" />
                    <Button x:Name="StopButton" Content="停止生成" Style="{StaticResource Button.FormGhost}"
                            Padding="16,9" Margin="0,6,0,0" Visibility="Collapsed"
                            Click="OnStopClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 底部状态 ============ -->
        <Grid Grid.Row="5" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BottomHint" Grid.Column="0" Text="AI 生成内容仅供参考；模型只在本地运行，不会上传聊天内容。"
                       FontSize="10" Foreground="#A6AEBB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SpeedText" Grid.Column="1" Text="" FontSize="10" Foreground="#8A93A3"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
