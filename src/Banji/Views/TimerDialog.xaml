<Window x:Class="Banji.Views.TimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计时器 - 班机"
        Width="472"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F9FD"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 分段模式切换（倒计时 / 正计时） -->
        <Style x:Key="SegmentedButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Brand}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#E7EEFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷分钟按钮 -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.BrandPressed}" />
            <Setter Property="Background" Value="#EEF3FF" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C9DAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Form}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
            <Setter Property="Padding" Value="22,9" />
        </Style>

        <Style x:Key="DialogGhostButton" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
            <Setter Property="Padding" Value="18,8" />
        </Style>
    </Window.Resources>

    <Border Background="#F7F9FD">
        <StackPanel Margin="26,20,26,22">

            <!-- 标题 -->
            <TextBlock Text="计时器" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="24" Foreground="{StaticResource Brush.TextPrimary}" />
            <TextBlock x:Name="SubtitleText" Text="给课堂计时：倒计时到点会全屏模糊提醒，正计时只计时不打扰。"
                       FontFamily="{StaticResource Font.Regular}" FontSize="12.5" Margin="0,4,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />

            <!-- 当前状态卡片 -->
            <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource Brush.Divider}"
                    BorderThickness="1" Padding="20,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusLabel" Text="未开始" FontFamily="{StaticResource Font.Medium}"
                                   FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock x:Name="TimeText" Text="00:00" FontFamily="{StaticResource Font.Bold}"
                                   FontWeight="Bold" FontSize="44" Foreground="{StaticResource Brush.TextPrimary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="CancelTimerButton" Grid.Column="1" Content="取消计时"
                            Style="{StaticResource DialogGhostButton}" VerticalAlignment="Center"
                            Visibility="Collapsed" Click="OnCancelTimerClick" />
                </Grid>
            </Border>

            <!-- 模式切换 -->
            <Border Background="#EDF1F8" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CountdownModeButton" Content="倒计时" GroupName="TimerMode"
                                 Style="{StaticResource SegmentedButton}" IsChecked="True"
                                 Checked="OnModeChecked" />
                    <RadioButton x:Name="StopwatchModeButton" Content="正计时" GroupName="TimerMode"
                                 Style="{StaticResource SegmentedButton}" Checked="OnModeChecked" />
                </StackPanel>
            </Border>

            <!-- 倒计时设置 -->
            <StackPanel x:Name="CountdownPanel" Margin="0,16,0,0">
                <TextBlock Text="快捷开始" FontFamily="{StaticResource Font.Medium}" FontSize="13"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Style="{StaticResource QuickButton}" Content="1 分钟" Tag="1" Click="OnQuickStartClick" />
                    <Button Style="{StaticResource QuickButton}" Content="3 分钟" Tag="3" Click="OnQuickStartClick" />
                    <Button Style="{StaticResource QuickButton}" Content="5 分钟" Tag="5" Click="OnQuickStartClick" />
                    <Button Style="{StaticResource QuickButton}" Content="7 分钟" Tag="7" Click="OnQuickStartClick" />
                    <Button Style="{StaticResource QuickButton}" Content="10 分钟" Tag="10" Click="OnQuickStartClick" />
                </WrapPanel>

                <TextBlock Text="自定义（分:秒）" FontFamily="{StaticResource Font.Medium}" FontSize="13"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,16,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CustomInput" Style="{StaticResource Input.TextBox}" Width="132" Height="38"
                             VerticalContentAlignment="Center" KeyDown="OnCustomInputKeyDown"
                             ToolTip="例如 5:30 表示 5 分 30 秒；只填数字表示分钟" />
                    <TextBlock Text="分:秒" FontFamily="{StaticResource Font.Regular}" FontSize="12"
                               Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Button Content="开始" Style="{StaticResource DialogPrimaryButton}" Margin="16,0,0,0"
                            Click="OnCustomStartClick" />
                </StackPanel>
                <TextBlock x:Name="InputErrorText" Text="" FontFamily="{StaticResource Font.Regular}" FontSize="12"
                           Foreground="{StaticResource Brush.Accent}" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- 正计时设置 -->
            <StackPanel x:Name="StopwatchPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <Border Background="#EEF3FF" CornerRadius="10" Padding="14,12">
                    <TextBlock Text="正计时从 0 开始累计，没有超时提醒，适合课堂活动计时。"
                               FontFamily="{StaticResource Font.Regular}" FontSize="12.5"
                               Foreground="{StaticResource Brush.BrandPressed}" TextWrapping="Wrap" />
                </Border>
                <Button Content="开始正计时" Style="{StaticResource DialogPrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnStartStopwatchClick" />
            </StackPanel>

            <!-- 底部 -->
            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="关闭本窗口不会停止计时，宠物旁会继续显示。"
                           FontFamily="{StaticResource Font.Regular}" FontSize="11.5"
                           Foreground="{StaticResource Brush.TextTertiary}" />
                <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource DialogGhostButton}"
                        Click="OnCloseClick" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
