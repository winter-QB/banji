<Window x:Class="Banji.Views.NoticeBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanjiNotice"
        Width="300" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.Regular}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!-- v1.3.0 提醒气泡：白底圆角卡片 + 轻阴影 + 深色文字；灵动冒出、轻柔回弹、定住 7 秒、收回。
         click-through，不抢焦点、不挡 PPT 操作。 -->
    <Grid x:Name="Outer" Margin="18,16,22,22" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PopOffset" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Card" CornerRadius="16" Background="#F9FBFF" BorderBrush="#E6ECF8" BorderThickness="1"
                Padding="16,12,16,12" MaxWidth="330">
            <Border.Effect>
                <DropShadowEffect Color="#16305C" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.20" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧强调色条：区分上课/下课/普通提醒 -->
                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="1.5"
                        Background="#317FFF" Margin="0,1,0,2" VerticalAlignment="Stretch" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" Text="班机提醒"
                               FontFamily="{StaticResource Font.Medium}" FontSize="11.5"
                               Foreground="#3E6BFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText" Text="" Margin="0,4,0,0"
                               FontFamily="{StaticResource Font.Regular}" FontSize="14.5"
                               Foreground="#1F2329" TextWrapping="Wrap" LineHeight="21" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock x:Name="TimeText" Text=""
                                   FontFamily="{StaticResource Font.Light}" FontSize="10.5"
                                   Foreground="#8A94A6" VerticalAlignment="Center" />
                        <TextBlock Text="班机" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Light}" FontSize="10"
                                   Foreground="#A9B2C2" />
                    </Grid>

                    <!-- 定住进度条：7 秒内缓缓缩短 -->
                    <Border Height="2.5" CornerRadius="1.5" Background="#EAF0FA" Margin="0,8,0,0"
                            ClipToBounds="True">
                        <Border x:Name="ProgressBar" Height="2.5" CornerRadius="1.5"
                                HorizontalAlignment="Stretch" Background="#8FBFE8FF"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

