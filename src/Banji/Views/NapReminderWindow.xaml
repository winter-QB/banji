<Window x:Class="Banji.Views.NapReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="午间提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <Image x:Name="BackdropImage" Stretch="UniformToFill" />
        <Border x:Name="DimLayer" Background="#000000" Opacity="0.52" />
        <Border x:Name="BlurVeil" Background="#000000" Opacity="0.001" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="12:50"
                       FontFamily="{StaticResource Font.Black}"
                       FontSize="120"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.55" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="上午自习"
                       FontFamily="{StaticResource Font.Bold}"
                       FontSize="56"
                       Foreground="#FFE08A"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="5" BlurRadius="24" Opacity="0.55" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="HintText"
                       Text="120 秒后自动关闭"
                       FontFamily="{StaticResource Font.Regular}"
                       FontSize="18"
                       Foreground="#E8EEFF"
                       HorizontalAlignment="Center"
                       Margin="0,22,0,0"
                       Opacity="0.85" />

            <Button x:Name="CloseButton"
                    Content="关 闭"
                    HorizontalAlignment="Center"
                    Margin="0,34,0,0"
                    Padding="42,14"
                    FontFamily="{StaticResource Font.Medium}"
                    FontSize="20"
                    Foreground="#1F2329"
                    Background="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8E4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
