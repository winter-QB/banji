<Window x:Class="Banji.Views.TimerTimeoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计时器超时"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root">
        <!-- 桌面截图 + 高斯模糊 -->
        <Image x:Name="BackdropImage" Stretch="UniformToFill" />
        <!-- 暗色遮罩（不透明度可在设置里调） -->
        <Border x:Name="DimLayer" Background="#000000" Opacity="0.45" />
        <!-- 上方再盖一层高斯模糊，保证模糊半径足够大 -->
        <Border x:Name="BlurVeil" Background="#000000" Opacity="0.001" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="计时器超时"
                       FontFamily="{StaticResource Font.Black}"
                       FontSize="96"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.55" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="HintText"
                       Text="15 秒后自动关闭"
                       FontFamily="{StaticResource Font.Regular}"
                       FontSize="18"
                       Foreground="#E8EEFF"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"
                       Opacity="0.85" />

            <Button x:Name="CloseButton"
                    Content="关 闭"
                    HorizontalAlignment="Center"
                    Margin="0,34,0,0"
                    Padding="42,14"
                    FontFamily="{StaticResource Font.Medium}"
                    FontSize="20"
                    Foreground="#1F2329"
                    Background="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8E4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
