<Window x:Class="Banji.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仪表盘 - 班机"
        Width="920"
        Height="700"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FD"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="DashPrimary" TargetType="Button" BasedOn="{StaticResource Button.Form}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="DashGhost" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,24,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <DockPanel Grid.Row="0" Margin="2,0,0,18" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="仪表盘" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                           FontSize="28" Foreground="{StaticResource Brush.TextPrimary}" />
                <TextBlock x:Name="HeaderDateText" Text="" FontFamily="{StaticResource Font.Regular}"
                           FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="BellOffsetText" DockPanel.Dock="Right" Text="" VerticalAlignment="Bottom"
                       HorizontalAlignment="Right" FontFamily="{StaticResource Font.Regular}" FontSize="12"
                       Foreground="{StaticResource Brush.TextTertiary}" />
        </DockPanel>

        <!-- 主体：左（当前状态 + 今日课表） / 右（抽签 + 花名册 + 快捷操作） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="332" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 当前状态 -->
                    <Border Style="{StaticResource DashCard}">
                        <StackPanel>
                            <TextBlock Text="当前状态" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Text="现在" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="CurrentCourseText" Text="—" Style="{StaticResource StatValue}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentTimeText" Text="" FontFamily="{StaticResource Font.Regular}"
                                               FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,14">
                                    <TextBlock Text="下一节" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="NextCourseText" Text="—" Style="{StaticResource StatValue}"
                                               Foreground="{StaticResource Brush.Accent}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NextTimeText" Text="" FontFamily="{StaticResource Font.Regular}"
                                               FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="距下课" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="UntilEndText" Text="—" Style="{StaticResource StatValue}"
                                               FontSize="20" Foreground="{StaticResource Brush.Brand}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="距上课" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="UntilNextText" Text="—" Style="{StaticResource StatValue}"
                                               FontSize="20" Foreground="{StaticResource Brush.Brand}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                    <TextBlock Text="距放学" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="UntilSchoolEndText" Text="—" Style="{StaticResource StatValue}"
                                               FontSize="20" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Text="剩余节数" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="PeriodsRemainingText" Text="—" Style="{StaticResource StatValue}"
                                               FontSize="20" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 今日课表 -->
                    <Border Style="{StaticResource DashCard}">
                        <StackPanel>
                            <TextBlock Text="今日课表" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <TextBlock x:Name="TodayListEmptyText" Text="今天没有课表数据"
                                       FontFamily="{StaticResource Font.Regular}" FontSize="12.5"
                                       Foreground="{StaticResource Brush.TextTertiary}" Margin="0,4,0,4" />
                            <StackPanel x:Name="TodayListPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 今日抽签 -->
                    <Border Style="{StaticResource DashCard}">
                        <StackPanel>
                            <TextBlock Text="今日抽签" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="次数" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="PickCountText" Text="0" Style="{StaticResource StatValue}"
                                               Foreground="{StaticResource Brush.Brand}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="最近抽中" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="LastPickText" Text="今天还没有抽过签" FontFamily="{StaticResource Font.Medium}"
                                               FontSize="14" Foreground="{StaticResource Brush.TextPrimary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 花名册规模 -->
                    <Border Style="{StaticResource DashCard}">
                        <StackPanel>
                            <TextBlock Text="花名册" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="份数" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="RosterCountText" Text="0" Style="{StaticResource StatValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="总人数" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="RosterStudentCountText" Text="0" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ActiveRosterText" Text="尚未激活花名册" FontFamily="{StaticResource Font.Regular}"
                                       FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 快捷操作 -->
                    <Border Style="{StaticResource DashCard}">
                        <StackPanel>
                            <TextBlock Text="快捷操作" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="抽签" Style="{StaticResource DashPrimary}" Click="OnPickClick" />
                                <Button Content="倒计时" Style="{StaticResource DashPrimary}" Click="OnTimerClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="设置" Style="{StaticResource DashGhost}" Click="OnSettingsClick" />
                                <Button Content="课表管理" Style="{StaticResource DashGhost}" Click="OnTimetableClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="花名册管理" Style="{StaticResource DashGhost}" Click="OnRosterClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
