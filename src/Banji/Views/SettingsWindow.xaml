<Window x:Class="Banji.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - 班机"
        Width="1024"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FD"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Banji;component/Controls/Toolbar/ToolButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 左侧导航项 -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#3A4250" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,9">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F2F5FB" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E9F0FF" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Brand}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Win11 开关 -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="pill" Width="42" Height="24" CornerRadius="12" Background="#D5DCE8">
                                    <Ellipse x:Name="knob" Width="18" Height="18" Fill="White"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource Brush.Brand}" />
                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="pill" Property="Background" Value="#C3CCDC" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="pill" Property="Background" Value="{StaticResource Brush.BrandHover}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Win11 风滑块 -->
            <Style x:Key="SettingSlider" TargetType="Slider">
                <Setter Property="Height" Value="26" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="26" Background="Transparent">
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Brand}"
                                                            VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="#E1E7F0"
                                                            VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="18" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="White" Stroke="{StaticResource Brush.Brand}" StrokeThickness="2.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="22,10" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <!-- 分段单选 -->
            <Style x:Key="SegmentedButton" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="18,7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Brand}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="#E7EEFF" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Form}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
                <Setter Property="Padding" Value="18,8" />
            </Style>

            <Style x:Key="SettingGhostButton" TargetType="Button" BasedOn="{StaticResource Button.FormGhost}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
                <Setter Property="Padding" Value="16,7" />
            </Style>

            <Style x:Key="SettingDangerButton" TargetType="Button" BasedOn="{StaticResource Button.Form}">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Background" Value="#FFF1F1" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧分区导航 -->
        <Border Background="White" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,22,12,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0">
                    <TextBlock Text="设置" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                               FontSize="26" Foreground="{StaticResource Brush.TextPrimary}" />
                    <TextBlock Text="所有更改立即生效" FontFamily="{StaticResource Font.Regular}" FontSize="12"
                               Foreground="{StaticResource Brush.TextTertiary}" Margin="0,4,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList" DockPanel.Dock="Top" Margin="0,18,0,0"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBoxItem Content="通用" Tag="general" />
                    <ListBoxItem Content="课堂" Tag="class" />
                    <ListBoxItem Content="抽签" Tag="pick" />
                    <ListBoxItem Content="按钮样式" Tag="buttons" />
                    <ListBoxItem Content="气泡" Tag="bubble" />
                    <ListBoxItem Content="宠物" Tag="pet" />
                    <ListBoxItem Content="计时与音效" Tag="timer" />
                    <ListBoxItem Content="提示预览" Tag="preview" />
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" Text="班机 v1.0 · 设置会自动保存"
                           FontFamily="{StaticResource Font.Regular}" FontSize="11"
                           Foreground="{StaticResource Brush.TextTertiary}" Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel x:Name="ContentHost" Margin="36,26,36,34" />
        </ScrollViewer>
    </Grid>
</Window>
