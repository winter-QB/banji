<Window x:Class="Banji.Views.MenuFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanjiMenu"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.Regular}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Win11 风格菜单项 -->
        <Style x:Key="Menu.Item" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDF2FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E1E9F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 带右侧开关/状态文字的菜单行 -->
        <Style x:Key="Menu.ItemStretch" TargetType="Button" BasedOn="{StaticResource Menu.Item}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="Menu.Danger" TargetType="Button" BasedOn="{StaticResource Menu.Item}">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>

        <Style x:Key="Menu.Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Light}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#9AA3AF" />
            <Setter Property="Margin" Value="14,7,10,3" />
        </Style>

        <!-- Win11 风格滑块 -->
        <Style x:Key="Menu.Slider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#E2E8F3" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#317FFF"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="White" />
                                                    <Ellipse Stroke="#317FFF" StrokeThickness="1.5" />
                                                    <Ellipse Width="6" Height="6" Fill="#317FFF" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.ValueBox" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Outer" Margin="16,12,20,26">
        <Border x:Name="Card" Background="#FBFCFE" BorderBrush="#E6EBF5" BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="#1E3A8A" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.22" />
            </Border.Effect>

            <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,8,6,9" TextOptions.TextFormattingMode="Ideal">
                <!-- 标题 -->
                <Grid Margin="10,2,10,9">
                    <TextBlock Text="班机" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                               FontSize="15" Foreground="#1F2329" VerticalAlignment="Center" />
                    <TextBlock Text="课堂管理桌面宠物" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Light}" FontSize="10" Foreground="#9AA3AF" />
                </Grid>
                <Border Height="1" Background="#EDF1F8" Margin="6,0,6,5" />

                <Button x:Name="MenuSettings" Style="{StaticResource Menu.Item}" Click="OnSettingsClick">
                    <TextBlock Text="设置" />
                </Button>
                <Button x:Name="MenuDashboard" Style="{StaticResource Menu.Item}" Click="OnDashboardClick">
                    <TextBlock Text="仪表盘" />
                </Button>
                <Button x:Name="MenuChat" Style="{StaticResource Menu.Item}" Click="OnChatClick">
                    <TextBlock Text="和班机聊天" />
                </Button>
                <Button x:Name="MenuRoster" Style="{StaticResource Menu.Item}" Click="OnRosterClick">
                    <TextBlock Text="花名册管理" />
                </Button>
                <Button x:Name="MenuTimetable" Style="{StaticResource Menu.Item}" Click="OnTimetableClick">
                    <TextBlock Text="课表管理" />
                </Button>
                <Button x:Name="MenuPeriods" Style="{StaticResource Menu.Item}" Click="OnPeriodsClick">
                    <TextBlock Text="课堂时段设置" />
                </Button>

                <Border Height="1" Background="#EDF1F8" Margin="6,5,6,5" />

                <Button x:Name="MenuToggleTimetable" Style="{StaticResource Menu.Item}" Click="OnToggleTimetableClick">
                    <TextBlock x:Name="ToggleTimetableText" Text="隐藏课表" />
                </Button>
                <Button x:Name="MenuCountdown" Style="{StaticResource Menu.ItemStretch}" Click="OnCountdownToggleClick">
                    <Grid>
                        <TextBlock Text="显示考试倒计时" VerticalAlignment="Center" />
                        <Border x:Name="CountdownSwitch" Width="34" Height="19" CornerRadius="9.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D7DEEA">
                            <Ellipse x:Name="CountdownKnob" Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="CountdownKnobOffset" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Button>

                <!-- 宠物大小（v1.2.0 只缩放宠物本体） -->
                <StackPanel Margin="12,7,12,2">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="宠物大小" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="PetScaleValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <Slider x:Name="PetScaleSlider" Style="{StaticResource Menu.Slider}"
                            Minimum="0.2" Maximum="5" ValueChanged="OnPetScaleSliderChanged" />
                </StackPanel>

                <!-- 课表大小（v1.2.0 独立缩放课表+常驻信息） -->
                <StackPanel Margin="12,3,12,2">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="课表大小" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="PanelScaleValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <Slider x:Name="PanelScaleSlider" Style="{StaticResource Menu.Slider}"
                            Minimum="0.4" Maximum="4" ValueChanged="OnPanelScaleSliderChanged" />
                </StackPanel>

                <!-- 课表左右位置（相对默认位置偏移） -->
                <StackPanel Margin="12,3,12,2">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="课表左右位置" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="PanelOffsetXValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <Slider x:Name="PanelOffsetXSlider" Style="{StaticResource Menu.Slider}"
                            Minimum="-300" Maximum="300" ValueChanged="OnPanelOffsetXChanged" />
                </StackPanel>

                <!-- 课表上下位置 -->
                <StackPanel Margin="12,3,12,3">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="课表上下位置" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="PanelOffsetYValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <Slider x:Name="PanelOffsetYSlider" Style="{StaticResource Menu.Slider}"
                            Minimum="-300" Maximum="300" ValueChanged="OnPanelOffsetYChanged" />
                </StackPanel>

                <!-- 按钮透明度 -->
                <StackPanel Margin="12,5,12,3">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="按钮透明度" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="ButtonOpacityValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <Slider x:Name="ButtonOpacitySlider" Style="{StaticResource Menu.Slider}"
                            Minimum="0" Maximum="100" ValueChanged="OnButtonOpacityChanged" />
                </StackPanel>

                <Border Height="1" Background="#EDF1F8" Margin="6,5,6,5" />

                <!-- 陪伴养成（第二轮新增）：使用天数 / 摸头 / 抽签 + 成就 -->
                <StackPanel Margin="12,4,12,2">
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="陪伴养成" FontSize="12" Foreground="#1F2329" VerticalAlignment="Center" />
                        <TextBlock x:Name="GrowthDaysValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="12" Foreground="#317FFF" />
                    </Grid>
                    <TextBlock x:Name="GrowthStatsText" Text="摸头 0 次 · 抽签 0 次 · 分组 0 次"
                               FontSize="10.5" Foreground="#8A94A6" TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                    <TextBlock x:Name="GrowthAchievementsText" Text="成就 0/10"
                               FontSize="10.5" Foreground="#9AA3AF" TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                </StackPanel>
                <Button x:Name="MenuGrowth" Style="{StaticResource Menu.ItemStretch}" Click="OnGrowthToggleClick">
                    <Grid>
                        <TextBlock Text="养成统计" VerticalAlignment="Center" />
                        <Border x:Name="GrowthSwitch" Width="34" Height="19" CornerRadius="9.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D7DEEA">
                            <Ellipse x:Name="GrowthKnob" Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="GrowthKnobOffset" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Button>

                <Border Height="1" Background="#EDF1F8" Margin="6,5,6,5" />

                <!-- 开关项 -->
                <Button x:Name="MenuAlwaysOnTop" Style="{StaticResource Menu.ItemStretch}" Click="OnAlwaysOnTopClick">
                    <Grid>
                        <TextBlock Text="始终置顶" VerticalAlignment="Center" />
                        <Border x:Name="AlwaysOnTopSwitch" Width="34" Height="19" CornerRadius="9.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D7DEEA">
                            <Ellipse x:Name="AlwaysOnTopKnob" Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="AlwaysOnTopKnobOffset" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="MenuAutoStart" Style="{StaticResource Menu.ItemStretch}" Click="OnAutoStartClick">
                    <Grid>
                        <TextBlock Text="开机自启" VerticalAlignment="Center" />
                        <Border x:Name="AutoStartSwitch" Width="34" Height="19" CornerRadius="9.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D7DEEA">
                            <Ellipse x:Name="AutoStartKnob" Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="AutoStartKnobOffset" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Button>

                <Border Height="1" Background="#EDF1F8" Margin="6,5,6,5" />

                <Button x:Name="MenuExit" Style="{StaticResource Menu.Danger}" Click="OnExitClick">
                    <TextBlock Text="杀死整个程序" Foreground="#E5484D" />
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>


