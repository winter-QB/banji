<Window x:Class="Banji.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:Banji.Controls.Pet"
        xmlns:toolbar="clr-namespace:Banji.Controls.Toolbar"
        Title="班机"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="320"
        Height="460"
        FontFamily="{StaticResource Font.Regular}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 头顶 / 左下角的小三角按钮 -->
        <Style x:Key="Pet.Triangle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24317FFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B317FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- v1.2.0：宠物本体（PetScale）与课表/信息面板（PanelScale+PanelOffset）分别缩放/定位，
         窗口尺寸由 code-behind 按两者包围盒计算，Canvas 负责绝对摆放。 -->
    <Canvas x:Name="RootCanvas" ClipToBounds="False">

        <!-- ① 课表 + 常驻信息面板：v1.5.0 统一为白底圆角卡片（专注简化态切换成透明 + 白色光晕文字） -->
        <Grid x:Name="PanelHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="PanelScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Border x:Name="PanelCard" CornerRadius="14" Background="#F5FFFFFF" BorderBrush="#14000000"
                    BorderThickness="1" Padding="14,11,14,12" Cursor="SizeAll" ToolTip="按住空白处可拖动课表">
                <Grid Width="196">
                    <StackPanel x:Name="PanelStack" Width="196">
                        <!-- v1.4.0：面板顶部周次（第 X 周 · 单/双周） -->
                        <pet:HaloTextLine x:Name="WeekHeaderLine" Height="15" Margin="0,0,0,4" Visibility="Collapsed" />
                        <!-- v1.4.0：黑板类岗位置顶（展开态常驻在课表最顶端） -->
                        <pet:HaloTextStack x:Name="TopTaskBody" RowHeight="19" LineSpacing="0" Margin="0,0,0,4"
                                           Visibility="Collapsed" />
                        <StackPanel x:Name="TimetableSection">
                            <pet:HaloTextLine x:Name="TimetableTitle" Height="16" Margin="0,0,0,5" />
                            <pet:HaloTextStack x:Name="TimetableBody" RowHeight="21" LineSpacing="1" />
                            <pet:HaloTextLine x:Name="TimetableEmpty" Height="18" Visibility="Collapsed" />
                        </StackPanel>
                        <!-- v1.4.0：值周/值日行（点击打开“值日与轮值”窗口） -->
                        <Border x:Name="DutyLineHost" Background="Transparent" Margin="0,4,0,0" Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonUp="OnDutyLineClick" ToolTip="打开值日与轮值">
                            <pet:HaloTextLine x:Name="DutyLine" Height="16" />
                        </Border>
                        <pet:HaloTextStack x:Name="InfoBody" LineSpacing="2" Margin="0,9,0,0" />
                    </StackPanel>

                    <!-- v1.5.0 折叠态内容（不再自带卡片背景，统一使用外层 PanelCard） -->
                    <StackPanel x:Name="FoldedCard" Width="196" Visibility="Collapsed" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonUp="OnFoldedCardClick" ToolTip="点击展开课表">
                        <!-- 黑板类岗位置顶（折叠态压成一行，如“擦黑板：张三”） -->
                        <TextBlock x:Name="FoldedTopTask" Text="" Margin="0,0,0,3" Visibility="Collapsed"
                                   FontFamily="{StaticResource Font.Medium}" FontSize="11"
                                   Foreground="#2F6BD8" TextTrimming="CharacterEllipsis" />
                        <Grid>
                            <TextBlock x:Name="FoldedLabel" Text="下节"
                                       FontFamily="{StaticResource Font.Medium}" FontSize="10.5"
                                       Foreground="#317FFF" VerticalAlignment="Center" />
                            <TextBlock x:Name="FoldedRightText" Text="点击展开" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Light}" FontSize="9" Foreground="#A2ABBB" />
                        </Grid>
                        <TextBlock x:Name="FoldedMain" Text="—" Margin="0,2,0,0"
                                   FontFamily="{StaticResource Font.Bold}" FontWeight="Bold" FontSize="15"
                                   Foreground="#1F2329" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FoldedSecondary" Text="" Margin="0,1,0,0" Visibility="Collapsed"
                                   FontFamily="{StaticResource Font.Light}" FontSize="10.5"
                                   Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
                        <!-- 值周/值日行（点击打开“值日与轮值”） -->
                        <TextBlock x:Name="FoldedDuty" Text="" Margin="0,3,0,0" Visibility="Collapsed"
                                   FontFamily="{StaticResource Font.Light}" FontSize="10.5" Foreground="#4A6FA5"
                                   TextTrimming="CharacterEllipsis" Cursor="Hand"
                                   MouseLeftButtonUp="OnFoldedDutyClick" ToolTip="打开值日与轮值" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ② 宠物群：宠物本体 + 头顶两个小三角 + 左下角功能区小三角（含展开的功能区），随 PetScale 缩放 -->
        <Grid x:Name="PetHost" Width="112" Height="134" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- 头顶两个小三角：折叠/展开课表、菜单 -->
            <Border x:Name="TrianglePill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,26,0"
                    CornerRadius="10" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                    Padding="2,1" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                </Border.Effect>
                <StackPanel x:Name="TriangleRow" Orientation="Horizontal">
                    <Button x:Name="TimetableTriangle" Style="{StaticResource Pet.Triangle}"
                            Click="OnTimetableTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="折叠/展开课表" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path x:Name="TimetableTrianglePath" Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="TimetableTriangleRotation" Angle="0" CenterX="5" CenterY="3" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="MenuTriangle" Style="{StaticResource Pet.Triangle}" Margin="4,0,0,0"
                            Click="OnMenuTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="菜单" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 宠物本体 + 左下角小三角 -->
            <Grid x:Name="PetArea" Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <pet:PetControl x:Name="Pet" HorizontalAlignment="Center" VerticalAlignment="Top" />

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,6"
                        CornerRadius="9" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                        Padding="1" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                    </Border.Effect>
                    <Button x:Name="FunctionTriangle" Style="{StaticResource Pet.Triangle}"
                            Width="22" Height="18" Click="OnFunctionTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="展开功能区" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path x:Name="FunctionTrianglePath" Data="M7,0 L0,6 L7,12 Z" Fill="#4A5563">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="FunctionTriangleRotation" Angle="0" CenterX="3.5" CenterY="6" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Border>
            </Grid>

            <!-- 向左展开的功能区：在宠物左侧；展开时 PetHost 宽度会从 112 变 282。
                 v1.5.0：白底容器放在 FunctionsBar 内部（避免外层 Border 影响其自适应测量）。 -->
            <Border x:Name="FunctionHost" Width="176" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,112,2">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FunctionHostOffset" X="0" />
                </Border.RenderTransform>
                <toolbar:FunctionsBar x:Name="FunctionsBarControl" />
            </Border>
        </Grid>

        <!-- v1.3.0 侧边粗弧线：宠物无动态自动收进屏幕侧边/手动隐藏宠物时显示；左键展开，右键菜单 -->
        <Grid x:Name="EdgeArcHost" Width="26" Height="130" HorizontalAlignment="Left" VerticalAlignment="Top"
              Visibility="Collapsed">
            <Border x:Name="EdgeArc" Width="16" Height="110" CornerRadius="8,0,0,8"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                    MouseLeftButtonUp="OnEdgeArcLeftClick" MouseRightButtonUp="OnEdgeArcRightClick"
                    ToolTip="展开班机">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#BCD6F8" Offset="0" />
                        <GradientStop Color="#8FB6F2" Offset="0.55" />
                        <GradientStop Color="#6E96DA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#16305C" BlurRadius="10" ShadowDepth="1" Direction="180" Opacity="0.30" />
                </Border.Effect>
                <Border Width="5" Height="72" CornerRadius="2.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="4,0,0,0" Background="#4DFFFFFF" />
            </Border>
        </Grid>
    </Canvas>
</Window>






