<Window x:Class="Banji.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:Banji.Controls.Pet"
        xmlns:toolbar="clr-namespace:Banji.Controls.Toolbar"
        Title="班机"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Font.Regular}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 头顶 / 左下角的小三角按钮 -->
        <Style x:Key="Pet.Triangle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24317FFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B317FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ScaleHost">
        <!-- 整体按 Settings.UiScale 无级缩放（无上下限） -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid x:Name="LayoutRoot" Margin="20,16,20,18">
            <StackPanel x:Name="PetStack" VerticalAlignment="Bottom" HorizontalAlignment="Right">

                <!-- 当天课表：纯文字悬浮桌面（无卡片背景），文字周围有重高斯模糊黑晕压暗背景 -->
                <StackPanel x:Name="TimetablePanel" Width="196" HorizontalAlignment="Right" Margin="0,0,0,9">
                    <pet:HaloTextLine x:Name="TimetableTitle" Height="16" Margin="0,0,0,5" />
                    <pet:HaloTextStack x:Name="TimetableBody" RowHeight="21" LineSpacing="1" />
                    <pet:HaloTextLine x:Name="TimetableEmpty" Height="18" Visibility="Collapsed" />
                </StackPanel>

                <!-- 常驻信息：每项一行，纯文字悬浮，无卡片 -->
                <StackPanel x:Name="InfoPanel" Width="196" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <pet:HaloTextStack x:Name="InfoBody" LineSpacing="2" />
                </StackPanel>

                <!-- 宠物头顶的两个小三角：折叠/展开课表、菜单（半透明胶囊底，保证在任意桌面上可读） -->
                <Border x:Name="TrianglePill" HorizontalAlignment="Right" Margin="0,0,26,2"
                        CornerRadius="10" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                        Padding="2,1" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                    </Border.Effect>
                    <StackPanel x:Name="TriangleRow" Orientation="Horizontal">
                    <Button x:Name="TimetableTriangle" Style="{StaticResource Pet.Triangle}"
                            Click="OnTimetableTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="折叠/展开课表" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path x:Name="TimetableTrianglePath" Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="TimetableTriangleRotation" Angle="0" CenterX="5" CenterY="3" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="MenuTriangle" Style="{StaticResource Pet.Triangle}" Margin="4,0,0,0"
                            Click="OnMenuTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="菜单" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563" />
                    </Button>
                    </StackPanel>
                </Border>

                <!-- 底部：向左展开的功能区 + 宠物本体 -->
                <Grid x:Name="BottomRow" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="FunctionHost" Grid.Column="0" Width="166" Visibility="Collapsed"
                            VerticalAlignment="Bottom" Margin="0,0,4,2" Padding="3">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="FunctionHostOffset" X="0" />
                        </Border.RenderTransform>
                        <toolbar:FunctionsBar />
                    </Border>

                    <Grid x:Name="PetArea" Grid.Column="1" Width="112" Height="112">
                        <pet:PetControl x:Name="Pet" HorizontalAlignment="Center" VerticalAlignment="Top" />

                        <!-- 左下角小三角：向左展开/收起功能区（半透明胶囊底） -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,6"
                                CornerRadius="9" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                                Padding="1" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                            </Border.Effect>
                        <Button x:Name="FunctionTriangle" Style="{StaticResource Pet.Triangle}"
                                Width="22" Height="18" Click="OnFunctionTriangleClick">
                            <Button.ToolTip>
                                <ToolTip Placement="Top">
                                    <TextBlock Text="展开功能区" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                                </ToolTip>
                            </Button.ToolTip>
                            <Path x:Name="FunctionTrianglePath" Data="M7,0 L0,6 L7,12 Z" Fill="#4A5563">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="FunctionTriangleRotation" Angle="0" CenterX="3.5" CenterY="6" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


