<Window x:Class="Banji.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:Banji.Controls.Pet"
        xmlns:toolbar="clr-namespace:Banji.Controls.Toolbar"
        Title="班机"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="320"
        Height="460"
        FontFamily="{StaticResource Font.Regular}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 头顶 / 左下角的小三角按钮 -->
        <Style x:Key="Pet.Triangle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24317FFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B317FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- v1.2.0：宠物本体（PetScale）与课表/信息面板（PanelScale+PanelOffset）分别缩放/定位，
         窗口尺寸由 code-behind 按两者包围盒计算，Canvas 负责绝对摆放。 -->
    <Canvas x:Name="RootCanvas" ClipToBounds="False">

        <!-- ① 课表 + 常驻信息面板：纯文字悬浮（无卡片），缩放/偏移独立 -->
        <Grid x:Name="PanelHost" Width="196" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="PanelScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <StackPanel x:Name="PanelStack" Width="196" HorizontalAlignment="Right">
                <StackPanel x:Name="TimetableSection">
                    <pet:HaloTextLine x:Name="TimetableTitle" Height="16" Margin="0,0,0,5" />
                    <pet:HaloTextStack x:Name="TimetableBody" RowHeight="21" LineSpacing="1" />
                    <pet:HaloTextLine x:Name="TimetableEmpty" Height="18" Visibility="Collapsed" />
                </StackPanel>
                <pet:HaloTextStack x:Name="InfoBody" LineSpacing="2" Margin="0,9,0,0" />
            </StackPanel>
        </Grid>

        <!-- ② 宠物群：宠物本体 + 头顶两个小三角 + 左下角功能区小三角（含展开的功能区），随 PetScale 缩放 -->
        <Grid x:Name="PetHost" Width="112" Height="134" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- 头顶两个小三角：折叠/展开课表、菜单 -->
            <Border x:Name="TrianglePill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,26,0"
                    CornerRadius="10" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                    Padding="2,1" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                </Border.Effect>
                <StackPanel x:Name="TriangleRow" Orientation="Horizontal">
                    <Button x:Name="TimetableTriangle" Style="{StaticResource Pet.Triangle}"
                            Click="OnTimetableTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="折叠/展开课表" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path x:Name="TimetableTrianglePath" Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="TimetableTriangleRotation" Angle="0" CenterX="5" CenterY="3" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="MenuTriangle" Style="{StaticResource Pet.Triangle}" Margin="4,0,0,0"
                            Click="OnMenuTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="菜单" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path Data="M0,0 L10,0 L5,6 Z" Fill="#4A5563" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 宠物本体 + 左下角小三角 -->
            <Grid x:Name="PetArea" Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <pet:PetControl x:Name="Pet" HorizontalAlignment="Center" VerticalAlignment="Top" />

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-2,0,0,6"
                        CornerRadius="9" Background="#D9F4F7FC" BorderBrush="#E6FFFFFF" BorderThickness="1"
                        Padding="1" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#0E2448" BlurRadius="7" ShadowDepth="1" Direction="270" Opacity="0.26" />
                    </Border.Effect>
                    <Button x:Name="FunctionTriangle" Style="{StaticResource Pet.Triangle}"
                            Width="22" Height="18" Click="OnFunctionTriangleClick">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="展开功能区" FontFamily="{StaticResource Font.Regular}" FontSize="12" />
                            </ToolTip>
                        </Button.ToolTip>
                        <Path x:Name="FunctionTrianglePath" Data="M7,0 L0,6 L7,12 Z" Fill="#4A5563">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="FunctionTriangleRotation" Angle="0" CenterX="3.5" CenterY="6" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Border>
            </Grid>

            <!-- 向左展开的功能区：在宠物左侧；展开时 PetHost 宽度会从 112 变 282 -->
            <Border x:Name="FunctionHost" Width="166" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,112,2" Padding="3">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FunctionHostOffset" X="0" />
                </Border.RenderTransform>
                <toolbar:FunctionsBar />
            </Border>
        </Grid>
    </Canvas>
</Window>
