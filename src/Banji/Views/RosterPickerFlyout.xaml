<Window x:Class="Banji.Views.RosterPickerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择抽签花名册"
        Width="300" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        FontFamily="{StaticResource Font.Regular}"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="RosterItemButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3ECFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F9" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="#E3E8F2" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#000000" />
        </Border.Effect>
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="14,10,8,6">
                <StackPanel>
                    <TextBlock Text="选择抽签花名册" FontFamily="{StaticResource Font.Medium}"
                               FontSize="14" Foreground="#1F2329" />
                    <TextBlock Text="点选后设为当前名单并关闭" FontSize="11" Foreground="#9AA3AF" Margin="0,2,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="✕" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick" />
            </Grid>

            <!-- 列表 -->
            <ScrollViewer Grid.Row="1" MaxHeight="330" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Text="还没有花名册，先导入或新建一份吧。"
                               FontSize="12" Foreground="#8A93A3" TextWrapping="Wrap" Margin="8,6,8,10"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="RosterItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RosterItemButton}" Tag="{Binding Id}"
                                        Click="OnRosterItemClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Medium}"
                                                           FontSize="13" Foreground="#1F2329"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                <Border Background="#E6F7EE" CornerRadius="999" Padding="6,0"
                                                        Margin="6,1,0,0" Visibility="{Binding ActiveVisibility}">
                                                    <TextBlock Text="当前" FontSize="10" Foreground="#12A150" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8A93A3"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11"
                                                   Foreground="#9AA3AF" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2" BorderBrush="#EEF1F6" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="12,8">
                <Grid>
                    <TextBlock Text="抽签结果会显示在当前名单上" FontSize="11" Foreground="#9AA3AF"
                               VerticalAlignment="Center" />
                    <Button Content="管理花名册…" HorizontalAlignment="Right" FontSize="12"
                            Foreground="#317FFF" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="OnManageClick" Padding="6,2" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
