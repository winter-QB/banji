<Window x:Class="Banji.Views.DutySetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="值日与轮值 · 首次配置 - 班机"
        Width="800"
        Height="680"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F9FD"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="WizardCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="WizardRadio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="WizardCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#E1E7F0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="值日与轮值 · 首次配置" FontFamily="{StaticResource Font.Bold}" FontWeight="Bold"
                       FontSize="24" Foreground="{StaticResource Brush.TextPrimary}" />
            <TextBlock x:Name="StepHintText" Text="" FontFamily="{StaticResource Font.Regular}" FontSize="12.5"
                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,14">
            <Border x:Name="Dot1" Style="{StaticResource StepDot}" />
            <Border x:Name="Dot2" Style="{StaticResource StepDot}" />
            <Border x:Name="Dot3" Style="{StaticResource StepDot}" />
            <Border x:Name="Dot4" Style="{StaticResource StepDot}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource WizardCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentHost" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Text="关闭向导视为未完成配置，下次打开会再次强制引导。"
                       FontFamily="{StaticResource Font.Regular}" FontSize="11.5"
                       Foreground="{StaticResource Brush.TextTertiary}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Button.FormGhost}"
                        Padding="18,8" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button x:Name="PrevButton" Content="上一步" Style="{StaticResource Button.FormGhost}"
                        Padding="18,8" Margin="0,0,10,0" Click="OnPrevClick" />
                <Button x:Name="NextButton" Content="下一步" Style="{StaticResource Button.Form}"
                        Padding="22,8" Margin="0,0,10,0" Click="OnNextClick" />
                <Button x:Name="FinishButton" Content="完成并保存" Style="{StaticResource Button.Form}"
                        Padding="22,8" Visibility="Collapsed" Click="OnFinishClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
