<UserControl x:Class="Banji.Controls.Toolbar.FunctionsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False"
             IsTabStop="False"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToolButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- v1.5.0：白底圆角容器（深色壁纸下按钮清晰）；内层 Host 保持原来的自适应布局 -->
    <Border x:Name="CardHost" Background="#F2FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
            CornerRadius="12" Padding="6" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#0E2448" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <!-- 外 Margin 4 用于容纳右下 45° 阴影（阴影距离 4px） -->
        <Grid x:Name="Host"
              Background="Transparent"
              Margin="2"
              HorizontalAlignment="Left"
              VerticalAlignment="Top" />
    </Border>
</UserControl>

