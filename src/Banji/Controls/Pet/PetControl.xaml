<UserControl x:Class="Banji.Controls.Pet.PetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="112" Height="112"
             Background="Transparent"
             Cursor="Hand"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- 宠物本体：极简几何团子（橙色系）+ 两个纯黑实心小圆点眼睛。
         用户明确要求：不要眼白/高光/瞳孔，不要腮红，不要鼻子嘴巴。 -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- 落地接触阴影（不随呼吸浮动） -->
        <Ellipse x:Name="ContactShadow"
                 Width="78" Height="13"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,5"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3D2A1810" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="BodyHost"
              Width="94" Height="100"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,4,0,0"
              RenderTransformOrigin="0.5,0.72">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BobOffset" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 身体 -->
            <Ellipse x:Name="Body" StrokeThickness="2">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.25,0" EndPoint="0.75,1">
                        <GradientStop Color="#E89A78" Offset="0" />
                        <GradientStop Color="#D97757" Offset="0.58" />
                        <GradientStop Color="#C96A4C" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 悬浮时的轻微提亮（叠在身体上，跟随身体形状） -->
            <Ellipse x:Name="HoverGlow" Opacity="0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#FFFFFF" />
                </Ellipse.Fill>
            </Ellipse>

            <!-- 两个纯黑实心小圆点眼睛 -->
            <Canvas x:Name="FaceCanvas" Width="94" Height="100" IsHitTestVisible="False">
                <Ellipse x:Name="EyeLeft" Width="22" Height="23"
                         Canvas.Left="23" Canvas.Top="35"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#231F20" />
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="EyeLeftBlink" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeRight" Width="22" Height="23"
                         Canvas.Left="49" Canvas.Top="35"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#231F20" />
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="EyeRightBlink" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
