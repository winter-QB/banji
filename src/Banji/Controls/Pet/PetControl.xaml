<UserControl x:Class="Banji.Controls.Pet.PetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="112" Height="112"
             Background="Transparent"
             Cursor="Hand"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- 宠物本体（第二轮用户要求）：方形、扁扁的方块生物，
         两只小方形手 + 两只小方形脚，两只纯黑实心小圆点眼睛；
         无腮红 / 无鼻子 / 无嘴巴 / 无高光；默认雾蓝色。 -->
    <Grid Background="{x:Null}">
        <!-- 落地接触阴影（不随呼吸浮动） -->
        <Ellipse x:Name="ContactShadow"
                 Width="88" Height="12"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,2"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4A14243D" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Canvas x:Name="BodyHost" Width="112" Height="112" RenderTransformOrigin="0.5,0.72">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BobOffset" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 两只小方块脚（在身体后面） -->
            <Border x:Name="FootLeft" Width="17" Height="13" CornerRadius="4"
                    Canvas.Left="30" Canvas.Top="84" BorderThickness="1.5" />
            <Border x:Name="FootRight" Width="17" Height="13" CornerRadius="4"
                    Canvas.Left="65" Canvas.Top="84" BorderThickness="1.5" />

            <!-- 方形、扁扁的身体 -->
            <Border x:Name="Body" Width="84" Height="64" CornerRadius="14"
                    Canvas.Left="14" Canvas.Top="22" BorderThickness="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#A9C9F6" Offset="0" />
                        <GradientStop Color="#8FB6F2" Offset="0.55" />
                        <GradientStop Color="#7BA4E6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 悬浮时的轻微提亮（只覆盖身体） -->
            <Border x:Name="HoverGlow" Width="84" Height="64" CornerRadius="14"
                    Canvas.Left="14" Canvas.Top="22" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />

            <!-- 两只小方块手（在身体前面，稍微压住身体两侧） -->
            <Border x:Name="HandLeft" Width="15" Height="15" CornerRadius="4"
                    Canvas.Left="4" Canvas.Top="56" BorderThickness="1.5" />
            <Border x:Name="HandRight" Width="15" Height="15" CornerRadius="4"
                    Canvas.Left="93" Canvas.Top="56" BorderThickness="1.5" />

            <!-- 两个纯黑实心小圆点眼睛（无眼白/高光/瞳孔） -->
            <Ellipse x:Name="EyeLeft" Width="13" Height="14"
                     Canvas.Left="38" Canvas.Top="45"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#231F20" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="EyeLeftBlink" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="EyeRight" Width="13" Height="14"
                     Canvas.Left="61" Canvas.Top="45"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#231F20" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="EyeRightBlink" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>

