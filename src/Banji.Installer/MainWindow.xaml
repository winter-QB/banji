<Window x:Class="Banji.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班机 安装程序"
        Width="640" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Regular}" FontSize="14"
        Foreground="{StaticResource Brush.TextMain}"
        Icon="Assets/banji.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="20" Background="{StaticResource Brush.BgWarm}" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.22" Color="#6B3B1E" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 自定义标题栏 ===== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/banji_256.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="班机 · 安装程序" Margin="8,0,0,0" FontSize="12.5" FontWeight="Bold"
                               Foreground="{StaticResource Brush.BrandOrange}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Button.Close}" HorizontalAlignment="Right"
                        Margin="0,8,14,8" Click="Close_Click" Content="✕" ToolTip="关闭" />
            </Grid>

            <!-- ===== 页面容器 ===== -->
            <Grid Grid.Row="1" Margin="36,2,36,26">

                <!-- 页面 1：欢迎 -->
                <Grid x:Name="PageWelcome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <Image Source="Assets/banji_256.png" Width="100" Height="100" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="班机" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="课堂管理桌面宠物 · 永远置顶的课堂小助手" Style="{StaticResource Text.Sub}"
                                   FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Border Margin="0,20,0,0" Background="{StaticResource Brush.BgPale}" CornerRadius="12"
                                Padding="20,11" HorizontalAlignment="Center">
                            <TextBlock Text="课程表提醒 · 公平抽签 · 倒计时 / 正计时 · 清醒一下"
                                       FontSize="12.5" Foreground="{StaticResource Brush.BrandOrangeDark}" />
                        </Border>
                        <TextBlock x:Name="TxtVersion" Text="版本 v1.0.0" Style="{StaticResource Text.Sub}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="安装程序会一并安装 HarmonyOS Sans SC 字体（遵循 HarmonyOS Sans Fonts License Agreement）。"
                                   Style="{StaticResource Text.Sub}" FontSize="11.5" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,6,0,0" MaxWidth="480" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0"
                                Click="Cancel_Click" />
                        <Button Content="下一步 →" Style="{StaticResource Button.Primary}" Click="Next_Click" />
                    </StackPanel>
                </Grid>

                <!-- 页面 2：选择安装目录 -->
                <Grid x:Name="PageDir" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="选择安装位置" Style="{StaticResource Text.Title}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Text.Sub}" Margin="0,8,0,0"
                               Text="班机将安装到下面的文件夹。默认位置只在当前用户下安装，不需要管理员权限：" />

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Style="{StaticResource TextBox.Cute}" Height="42"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Button.Secondary}"
                                Margin="10,0,0,0" Padding="18,9" Click="Browse_Click" />
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="TxtInstalledHint" Style="{StaticResource Text.Sub}"
                               Foreground="{StaticResource Brush.BrandOrange}" Margin="0,12,0,0"
                               Visibility="Collapsed" />

                    <Border Grid.Row="4" Background="{StaticResource Brush.BgPale}" CornerRadius="12"
                            Padding="16,12" VerticalAlignment="Top" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="小提示" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource Brush.BrandOrangeDark}" />
                            <TextBlock Style="{StaticResource Text.Sub}" FontSize="12.5" Margin="0,4,0,0"
                                       Text="卸载班机时，程序文件、快捷方式和字体都会被清理；花名册、课表、设置等数据保存在 %APPDATA%\Banji，不会被删除。" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="← 上一步" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0"
                                Click="Back_Click" />
                        <Button Content="开始安装" Style="{StaticResource Button.Primary}" Click="Install_Click" />
                    </StackPanel>
                </Grid>

                <!-- 页面 3：安装进度 -->
                <Grid x:Name="PageProgress" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="Assets/banji_256.png" Width="72" Height="72" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TxtProgressTitle" Text="正在安装班机…" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <ProgressBar x:Name="BarProgress" Style="{StaticResource Progress.Cute}" Maximum="100"
                                     Margin="0,28,0,0" />
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="TxtStatus" Style="{StaticResource Text.Sub}"
                                       HorizontalAlignment="Left" Text="准备中…" />
                            <TextBlock x:Name="TxtPercent" Style="{StaticResource Text.Sub}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.BrandOrange}" HorizontalAlignment="Right"
                                       Text="0%" />
                        </Grid>
                        <TextBlock Text="安装过程中请不要关闭窗口。" Style="{StaticResource Text.Sub}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 页面 4：完成 -->
                <Grid x:Name="PageDone" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <Image Source="Assets/banji_256.png" Width="92" Height="92" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="安装完成！" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.BrandOrange}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="班机已安装到：" Style="{StaticResource Text.Sub}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock x:Name="TxtDonePath" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMain}" HorizontalAlignment="Center"
                                   MaxWidth="500" Margin="0,4,0,0" />
                        <TextBlock Text="双击桌面上的「班机」即可启动。第一次启动后，可以导入花名册和课程表。"
                                   Style="{StaticResource Text.Sub}" HorizontalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="480" Margin="0,14,0,0" />
                        <CheckBox x:Name="ChkLaunch" Style="{StaticResource Check.Cute}" Content="立即启动班机"
                                  IsChecked="True" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="完成" Style="{StaticResource Button.Primary}" Click="Finish_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
